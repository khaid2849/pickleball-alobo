<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Court Search Wizard Form View -->
    <record id="view_pickleball_court_search_wizard_form" model="ir.ui.view">
        <field name="name">pickleball.court.search.form</field>
        <field name="model">pickleball.court.search</field>
        <field name="arch" type="xml">
            <form string="Search Available Courts">
                <sheet>
                    <!-- Page title -->
                    <div class="oe_title">
                        <h1>Search Available Courts</h1>
                        <p class="text-muted">
                            Search for available pickleball courts on the Alobo booking platform.
                        </p>
                    </div>

                    <!-- ── Search Filters ── -->
                    <group string="Search Filters">
                        <group>
                            <field name="province_id" options="{'no_create': True, 'no_open': True}" placeholder="Select province or city…"/>
                            <field name="ward_id" domain="[('state_id', '=', province_id)]" options="{'no_create': True, 'no_open': True}" placeholder="All wards (optional)…"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>

                    <!-- Hidden fields -->
                    <field name="state" invisible="1"/>
                    <field name="sport_type" invisible="1"/>

                    <!-- ── Results Summary — shown only after a search ── -->
                    <div invisible="state == 'search'">

                        <!-- Success banner: there are available courts -->
                        <div class="alert alert-success mb-3" invisible="available_count == 0">
                            <strong>
                                <i class="fa fa-check-circle me-1"/>
                                <field name="available_count" nolabel="1" readonly="1"/>
                                venue(s) with available courts
                            </strong>
                            out of
                            <field name="total_count" nolabel="1" readonly="1"/>
                            total venues found.
                        </div>

                        <!-- Warning banner: no available courts -->
                        <div class="alert alert-warning mb-3" invisible="available_count != 0">
                            <i class="fa fa-exclamation-triangle me-1"/>
                            <strong>No courts available</strong>
                            for the selected criteria.
                            <field name="total_count" nolabel="1" readonly="1"/>
                            venue(s) found but none have open slots — try a different
                            time window or location.
                        </div>

                        <!-- ── Results List ── -->
                        <field name="result_ids" string="Available Courts" nolabel="1" readonly="1" context="{'form_view_ref': 'pickleball-team.view_pickleball_court_search_result_wizard_form'}">
                            <list string="Court Search Results" decoration-success="has_availability == True" decoration-muted="has_availability == False" default_order="has_availability desc, branch_name asc">
                                <field name="branch_name" string="Venue" optional="show"/>
                                <field name="address" string="Address" optional="show"/>
                                <field name="phone" string="Phone" optional="show"/>
                                <field name="yard_count" string="Courts" optional="show"/>
                                <field name="available_yards" string="Available Courts" optional="show"/>
                                <field name="has_availability" column_invisible="1"/>
                                <field name="rating" string="Rating" optional="hide"/>
                            </list>
                        </field>
                    </div>
                </sheet>
                <footer>
                        <button name="action_search" type="object" string="Search Available Courts" class="btn btn-primary" icon="fa-search"/>
                        <button name="action_new_search" type="object" string="New Search" class="btn btn-secondary ms-2" invisible="state == 'search'"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Court Search Wizard Action -->
    <record id="action_pickleball_court_search" model="ir.actions.act_window">
        <field name="name">Find Available Courts</field>
        <field name="res_model">pickleball.court.search</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pickleball_court_search_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>

