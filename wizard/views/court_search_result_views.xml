<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Court Search Result Wizard Form View -->
    <record id="view_pickleball_court_search_result_wizard_form" model="ir.ui.view">
        <field name="name">pickleball.court.search.result.form</field>
        <field name="model">pickleball.court.search.result</field>
        <field name="arch" type="xml">
            <form string="Available Courts">
                <sheet>
                    <group>
                        <group>
                            <field name="branch_name" string="Venue"/>
                            <field name="address" string="Address"/>
                            <field name="phone" string="Phone"/>
                        </group>
                        <group>
                            <field name="rating" string="Rating"/>
                            <field name="yard_count" string="Courts"/>
                            <field name="available_yards" string="Available Courts"/>
                            <field name="has_availability" string="Available"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>

