<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_sync_alobo_courts" model="ir.cron">
            <field name="name">Pickleball: Sync Alobo Courts</field>
            <field name="model_id" ref="pickleball-team.model_pickleball_court"/>
            <field name="state">code</field>
            <field name="code">model.action_sync_alobo_courts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- 12:00 ICT (UTC+7) = 05:00 UTC -->
            <field name="nextcall">2026-10-10 05:00:00</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
